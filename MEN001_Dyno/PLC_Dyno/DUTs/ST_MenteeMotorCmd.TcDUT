<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MenteeMotorCmd" Id="{ceb40dc5-a845-4343-9e91-f8723c8ecc72}">
    <Declaration><![CDATA[// RxPDO — written by TwinCAT to Mentee Motor Slave (0x7000)
// Written by Python via GVL_MenteeMotor, consumed by FB_MenteeMotorHandler
TYPE ST_MenteeMotorCmd :
STRUCT
    kp                  : REAL;     // Position gain
    kd                  : REAL;     // Velocity gain
    p_des               : REAL;     // Desired position [rad or units]
    v_des               : REAL;     // Desired velocity [rad/s or units/s]
    torque_feed_forward : REAL;     // Feed forward torque [Nm or %]
    max_torque          : REAL;     // Max torque limit [Nm or %]
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>