<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{0726ba31-cfa3-4f4b-8cfa-b894f8445811}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	i: INT;
	ton_TwinSAFE_ACK_reset: TON;
	BlinkLED: ton;

	Pulse_On_TON: TON;
	Pulse_Off_TON: TON;
	bPulse	:	BOOL	;
	
	t_BlinkTime : TIME	;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[i:=i+1;


ton_TwinSAFE_ACK_reset(IN:=GVL_Safety.stTwinSAFE_OUT.ErrACK, PT:=T#10S);
IF ton_TwinSAFE_ACK_reset.Q THEN;
	GVL_Safety.stTwinSAFE_OUT.ErrACK:=FALSE;
END_IF
GVL_Safety.stTwinSAFE_OUT.DoorMonitor:=GVL_Safety.DoorMonitorFromPLC;

GVL_Safety.stTwinSAFE_OUT.act_Velocity_DR1:=GVL_Safety.stTwinSAFE_IN.act_Velocity_DR1=0;
GVL_Safety.stTwinSAFE_OUT.act_Velocity_DR2:=GVL_Safety.stTwinSAFE_IN.act_Velocity_DR2=0;

IF GVL_Safety.stTwinSAFE_OUT.BatRelay_CMD THEN
	GVL_Safety.stTwinSAFE_OUT.BatRelay_Manual_Off:=FALSE;
	GVL_Safety.stTwinSAFE_OUT.BatRelay_Manual_On:=TRUE;
ELSE
	GVL_Safety.stTwinSAFE_OUT.BatRelay_Manual_Off:=TRUE;
	GVL_Safety.stTwinSAFE_OUT.BatRelay_Manual_On:=FALSE;
END_IF


IF GVL_Safety.stTwinSAFE_OUT.BatBMS_Cmd THEN
	GVL_Safety.stTwinSAFE_OUT.RB_BatBMS_Manual_Off:=FALSE;
	GVL_Safety.stTwinSAFE_OUT.RB_BatBMS_Manual_On:=TRUE;
ELSE
	GVL_Safety.stTwinSAFE_OUT.RB_BatBMS_Manual_Off:=TRUE;
	GVL_Safety.stTwinSAFE_OUT.RB_BatBMS_Manual_On:=FALSE;

END_IF

act_LED_Control();










]]></ST>
    </Implementation>
    <Action Name="act_LED_Control" Id="{3c867c17-f4c4-4546-bd10-836abda837f5}">
      <Implementation>
        <ST><![CDATA[//Red 
IF GVL_Safety.stTwinSAFE_IN.EStop_Ok AND GVL_Safety.stTwinSAFE_IN.EStop_Status THEN
	//Red Off
	GVL_IO.RedLED:= FALSE;
ELSIF GVL_Safety.stTwinSAFE_IN.EStop_Ok=FALSE AND GVL_Safety.stTwinSAFE_IN.EStop_Status  THEN
	//Red Blink 
	GVL_IO.RedLED:=bPulse;
ELSIF GVL_Safety.stTwinSAFE_IN.EStop_Ok=FALSE AND GVL_Safety.stTwinSAFE_IN.EStop_Status=FALSE THEN
	//Red On
	GVL_IO.RedLED:= TRUE;
END_IF

//Blue
IF GVL_Safety.stTwinSAFE_OUT.DoorMonitor AND GVL_Safety.stTwinSAFE_IN.Speps.step1 THEN
	//Blue Blink
	GVL_IO.BlueLED:=bPulse;
ELSIF GVL_Safety.stTwinSAFE_OUT.DoorMonitor AND GVL_Safety.stTwinSAFE_OUT.SolenoedMonitor=FALSE THEN
	//Blue Off
	GVL_IO.BlueLED:=FALSE;
ELSIF GVL_Safety.stTwinSAFE_OUT.DoorMonitor=FALSE THEN
	//Blue On
	GVL_IO.BlueLED:=TRUE;
END_IF

//Green
IF (GVL_Safety.stTwinSAFE_IN.Speps.step1 AND GVL_Safety.stTwinSAFE_IN.EStop_Ok AND GVL_Safety.stTwinSAFE_OUT.DoorMonitor=TRUE) OR GVL_Safety.stTwinSAFE_IN.Speps.step2 THEN
	//Green Blink
	GVL_IO.GreenLED:=bPulse;
ELSIF GVL_Safety.stTwinSAFE_IN.Safety_Armed THEN
	//Green On
	GVL_IO.GreenLED:=TRUE;
ELSIF GVL_Safety.stTwinSAFE_IN.Speps.step4 OR GVL_Safety.stTwinSAFE_IN.Speps.step5 
OR GVL_Safety.stTwinSAFE_IN.Speps.step6 OR GVL_Safety.stTwinSAFE_OUT.DoorMonitor=FALSE THEN
	//Green Off
	GVL_IO.GreenLED:=FALSE;
END_IF

IF GVL_Safety.stTwinSAFE_IN.Speps.step2  THEN
	t_BlinkTime:=T#0.5S;
ELSE
	t_BlinkTime:=T#1.5S;
END_IF

Pulse_On_TON(IN:=NOT bPulse , PT:=t_BlinkTime , Q=> , ET=> );
Pulse_Off_TON(IN:=bPulse , PT:=t_BlinkTime , Q=> , ET=> );
IF Pulse_On_TON.Q AND NOT bPulse THEN bPulse:=TRUE; END_IF;
IF Pulse_Off_TON.Q AND bPulse THEN bPulse:=FALSE; END_IF;

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(*
BlinkLED(IN:= GVL_Safety.stTwinSAFE_IN.Speps.step1 AND NOT GVL_IO.GreenLED , PT:=T#1S , Q=> , ET=> );

IF BlinkLED.Q THEN
	GVL_IO.GreenLED:= NOT GVL_IO.GreenLED;
END_IF

IF GVL_Safety.stTwinSAFE_IN.Speps.step1 THEN
	
	GVL_IO.GreenLED:= NOT GVL_IO.GreenLED;
	GVL_IO.RedLED:= FALSE;
	GVL_IO.BlueLED:=NOT GVL_IO.BlueLED;
	
ELSIF GVL_Safety.stTwinSAFE_IN.Speps.step3 THEN
	GVL_IO.GreenLED:=TRUE;
	GVL_IO.RedLED:= FALSE;
	GVL_IO.BlueLED:=FALSE;
	
ELSIF GVL_Safety.stTwinSAFE_IN.Speps.step4 OR GVL_Safety.stTwinSAFE_IN.Speps.step5 THEN
	GVL_IO.GreenLED:=FALSE;
	GVL_IO.RedLED:= TRUE;
	GVL_IO.BlueLED:=FALSE;
	
ELSE
	GVL_IO.GreenLED:=FALSE;
	GVL_IO.RedLED:= FALSE;
	GVL_IO.BlueLED:=FALSE;
END_IF
*)]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>