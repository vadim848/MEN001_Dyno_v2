<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MenteeMotorV32OsStatus" Id="{6b6c7ce0-c484-4e6d-9706-e7f57144e2fa}">
    <Declaration><![CDATA[// TxPDO 0x1A01 "Motor Response OS" — read by TwinCAT from Motor Slave V3.2 (0x6001)
// Written by FB_MenteeMotorV32OsHandler, read by Python via GVL_MenteeMotorV32_OS / GVL_Sync snapshot
TYPE ST_MenteeMotorV32OsStatus :
STRUCT
    nStatusWord     : UDINT;                                    // 0x6001:01 status_word (raw)
    nSampleCount    : UDINT;                                    // 0x6001:02 sample_count (rolling)
    aSamples        : ARRAY[0..9] OF ST_MenteeMotorV32OsSample; // 0x6001:03..2A  s0..s9 buffer

    // Decoded status — decode convention mirrors FB_UartBridgeHandler (VERIFY vs motor FW)
    nFsmState               : BYTE;     // status_word bits 3:0
    nMainState              : BYTE;     // bits 7:4
    nOpMode                 : BYTE;     // bits 10:8
    nGeneralErrorBits       : BYTE;     // bits 23:16
    nCategorialErrorBits    : BYTE;     // bits 31:24
    bError                  : BOOL;     // TRUE if any error bit set
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>