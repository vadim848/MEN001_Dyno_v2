<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_SyncSnapshot" Id="{0acbebc6-4faa-4ca5-98f6-0e8056c02560}">
    <Declaration><![CDATA[TYPE ST_SyncSnapshot :
STRUCT
    // Cycle identification
    nCycleCount             : UDINT;    // Increments each PLC cycle
    nDcTimestamp            : ULINT;    // DC time in nanoseconds (F_GetCurDcTaskTime64 / DCTIME64)

    // UART Bridge — V3.1 status + live data
    stBridge                : ST_UartBridgeStatus;

    // Mentee Motor — V3.2 direct motor status
    stMotor                 : ST_MenteeMotorStatus;

    // Encoders
    stEncoder1              : ST_EncoderData;
    stEncoder2              : ST_EncoderData;

    // Analog inputs
    stAnalogIn1             : ST_AnalogInData;
    stAnalogIn2             : ST_AnalogInData;

    // Motor control status
    stMotor1Status          : ST_MotorStatus;
    stMotor2Status          : ST_MotorStatus;

    // Safety
    bEStopActive            : BOOL;
	
	stMotorV32_OS           : ST_MenteeMotorV32OsStatus;    // V3.2 motor #2 (slot-2 OS, 0x1A01)  <-- NEW
	bTrajRunning            : BOOL;                         // V3.2 trajectory generator active (FB_TrajectoryGen)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>