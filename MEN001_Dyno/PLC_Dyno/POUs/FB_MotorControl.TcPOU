<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_MotorControl" Id="{de18ef15-dba8-420b-a037-a010c18e4a02}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotorControl
VAR_IN_OUT
    Axis            : AXIS_REF;
END_VAR

VAR_INPUT
    stCmd           : ST_MotorCommand;
END_VAR

VAR_OUTPUT
    stStatus        : ST_MotorStatus;
END_VAR

VAR
    nActTorque_Raw  AT %I* : INT;

    fbPower         : MC_Power;
    fbMoveAbs       : MC_MoveAbsolute;
    fbMoveRel       : MC_MoveRelative;
    fbMoveVel       : MC_MoveVelocity;
    fbStop          : MC_Stop;
    fbReset         : MC_Reset;
    fbSoeReset      : FB_SoEReset;     // Tc2_MC2_Drive — SoE drive reset (S-0-0099)
    fbHome          : MC_Home;
    fbSetPosition   : MC_SetPosition;

    rtExecuteMove   : R_TRIG;
    rtStop          : R_TRIG;
    rtResetError    : R_TRIG;
    rtSoeReset      : R_TRIG;          // diagnostic: SoE drive reset only
    rtNcReset       : R_TRIG;          // diagnostic: NC axis reset only
    rtHome          : R_TRIG;
    rtZeroPosition  : R_TRIG;
    ftSoeBusy       : F_TRIG;          // SoE-reset Busy falling edge -> clear the latch

    eState          : E_MotorState;
    bMoveLatch      : BOOL;
    bSoeResetExec   : BOOL;            // latch: SoE drive reset requested / in progress
    bNcResetExec    : BOOL;            // latch: NC axis reset requested / in progress
    nResetStage     : BYTE;            // RESETTING sequence: 1 SoE | 2 settle | 3 NC
    tonSettle       : TON;             // drive-settle gap between SoE and NC reset
    tonResetGuard   : TON;             // whole-sequence watchdog -> back to ERROR
    fPrevVelocity   : LREAL;
END_VAR
VAR CONSTANT
    T_RESET_SETTLE  : TIME := T#250MS; // drive settle after the SoE reset completes
    T_RESET_GUARD   : TIME := T#15S;   // > FB_SoEReset's 10 s timeout + NC reset
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//----------------------------------------------------------------------
// EDGE DETECTION
//----------------------------------------------------------------------
rtExecuteMove (CLK := stCmd.bExecuteMove);
rtStop        (CLK := stCmd.bStop);
rtResetError  (CLK := stCmd.bResetError);
rtSoeReset    (CLK := stCmd.bSoeReset);
rtNcReset     (CLK := stCmd.bNcReset);
rtHome        (CLK := stCmd.bHome);
rtZeroPosition(CLK := stCmd.bZeroPosition);

// Diagnostic single-shot resets — latch the respective background FB. Gated
// to non-motion states: MC_Reset on a MOVING axis hard-aborts the travel
// command (no deceleration ramp) and an SoE reset is comparably disruptive
// at the drive level — on a coupled bench that is a mechanical hazard, not a
// diagnostic. (The full sequenced recovery is the bResetError path below.)
IF (eState = E_MotorState.DISABLED) OR (eState = E_MotorState.READY)
        OR (eState = E_MotorState.ERROR) THEN
    IF rtSoeReset.Q THEN
        bSoeResetExec := TRUE;
    END_IF
    IF rtNcReset.Q THEN
        bNcResetExec := TRUE;
    END_IF
END_IF

//----------------------------------------------------------------------
// POWER — called every cycle
//----------------------------------------------------------------------
fbPower(
    Axis            := Axis,
    Enable          := (eState = E_MotorState.ENABLING
                     OR eState = E_MotorState.READY
                     OR eState = E_MotorState.MOVING
                     OR eState = E_MotorState.STOPPING
                     OR eState = E_MotorState.HOMING),
    Enable_Positive := (eState = E_MotorState.ENABLING
                     OR eState = E_MotorState.READY
                     OR eState = E_MotorState.MOVING
                     OR eState = E_MotorState.STOPPING
                     OR eState = E_MotorState.HOMING),
    Enable_Negative := (eState = E_MotorState.ENABLING
                     OR eState = E_MotorState.READY
                     OR eState = E_MotorState.MOVING
                     OR eState = E_MotorState.STOPPING
                     OR eState = E_MotorState.HOMING),
    Override        := 100.0,
    BufferMode      := MC_Aborting);

//----------------------------------------------------------------------
// SET POSITION — zero axis on rising edge, only in READY state
//----------------------------------------------------------------------
fbSetPosition(
    Axis     := Axis,
    Execute  := rtZeroPosition.Q,
    Position := 0.0,
    Mode     := FALSE);

IF fbSetPosition.Done  THEN stStatus.bZeroDone := TRUE; END_IF
IF fbSetPosition.Error THEN stStatus.bError    := TRUE;
                             stStatus.nErrorID  := fbSetPosition.ErrorID; END_IF

//----------------------------------------------------------------------
// STOP FB — called every cycle, Execute held TRUE only in STOPPING
//----------------------------------------------------------------------
fbStop(
    Axis         := Axis,
    Execute      := (eState = E_MotorState.STOPPING),
    Deceleration := SEL(stCmd.fDeceleration > 0, 500.0, stCmd.fDeceleration),
    Jerk         := stCmd.fJerk);

//----------------------------------------------------------------------
// MOVE FBs — called every cycle, Execute driven by state + latch
//----------------------------------------------------------------------
fbMoveAbs(
    Axis         := Axis,
    Execute      := bMoveLatch AND (eState = E_MotorState.MOVING)
                   AND (stCmd.eControlMode = E_ControlMode.POSITION)
                   AND NOT stCmd.bRelative,
    Position     := stCmd.fTargetPosition,
    Velocity     := SEL(stCmd.fTargetVelocity > 0,
                        stCmd.fMaxVelocity, stCmd.fTargetVelocity),
    Acceleration := stCmd.fAcceleration,
    Deceleration := stCmd.fDeceleration,
    Jerk         := stCmd.fJerk,
    BufferMode   := MC_Aborting);

fbMoveRel(
    Axis         := Axis,
    Execute      := bMoveLatch AND (eState = E_MotorState.MOVING)
                   AND (stCmd.eControlMode = E_ControlMode.POSITION)
                   AND stCmd.bRelative,
    Distance     := stCmd.fTargetPosition * stCmd.fDirection,
    Velocity     := SEL(stCmd.fTargetVelocity > 0,
                        stCmd.fMaxVelocity, stCmd.fTargetVelocity),
    Acceleration := stCmd.fAcceleration,
    Deceleration := stCmd.fDeceleration,
    Jerk         := stCmd.fJerk,
    BufferMode   := MC_Aborting);

fbMoveVel(
    Axis         := Axis,
    Execute      := bMoveLatch AND (eState = E_MotorState.MOVING)
                   AND (stCmd.eControlMode = E_ControlMode.VELOCITY),
    Velocity     := ABS(stCmd.fTargetVelocity),
    Direction    := SEL(stCmd.fTargetVelocity >= 0,
                        MC_Negative_Direction, MC_Positive_Direction),
    Acceleration := stCmd.fAcceleration,
    Deceleration := stCmd.fDeceleration,
    Jerk         := stCmd.fJerk,
    BufferMode   := MC_Aborting);

//----------------------------------------------------------------------
// SoE DRIVE RESET (FB_SoEReset, Tc2_MC2_Drive) — resets the AX5000 drive via
// S-0-0099 (a separate action from MC_Reset's NC reset). Called every cycle;
// triggered (latched) from the ERROR-state reset and runs to completion in the
// background. NetId '' = local controller; set it if the drive's NC is remote.
//----------------------------------------------------------------------
fbSoeReset(Axis := Axis, NetId := '', Execute := bSoeResetExec, Timeout := T#10S);
ftSoeBusy(CLK := fbSoeReset.Busy);
IF ftSoeBusy.Q THEN
    bSoeResetExec := FALSE;          // Busy 1->0: SoE reset finished (Error/SercosErrId valid)
END_IF
IF bSoeResetExec AND fbSoeReset.Error THEN
    bSoeResetExec := FALSE;          // immediate error (Busy never rose) -> don't hang the latch
END_IF

//----------------------------------------------------------------------
// NC AXIS RESET (MC_Reset) — called every cycle; latched from the sequenced
// recovery (RESETTING stage 3) or the diagnostic bNcReset command. The latch
// drops Execute back to FALSE on Done/Error, so every request produces a
// fresh rising edge (a one-shot Execute:=TRUE call would fire only once per
// PLC run — MC blocks trigger on the Execute edge).
//----------------------------------------------------------------------
fbReset(Axis := Axis, Execute := bNcResetExec);
IF bNcResetExec AND (fbReset.Done OR fbReset.Error) THEN
    bNcResetExec := FALSE;
END_IF

//----------------------------------------------------------------------
// STATE MACHINE
//----------------------------------------------------------------------
CASE eState OF

    E_MotorState.DISABLED:
        IF stCmd.bEnable THEN
            eState := E_MotorState.ENABLING;
        END_IF

    E_MotorState.ENABLING:
        IF NOT stCmd.bEnable THEN
            eState := E_MotorState.DISABLED;
        ELSIF fbPower.Error THEN
            eState := E_MotorState.ERROR;
        ELSIF fbPower.Status THEN
            eState := E_MotorState.READY;
        END_IF

    E_MotorState.READY:
        bMoveLatch    := FALSE;
        fPrevVelocity := 0.0;
        stCmd.bStop   := FALSE;

        IF NOT stCmd.bEnable THEN
            // Route disable through STOPPING so MC_Stop runs first. If torque was
            // applied the axis is still in CST (torque) mode after Stop Torque;
            // MC_Stop performs the CST->position changeover and decelerates to a
            // real standstill BEFORE MC_Power drops. Withdrawing controller enable
            // straight from CST tripped NC 0x4260 (enable removed while the axis
            // was still positioning). STOPPING -> fbStop.Done -> DISABLED (SEL on
            // bEnable). Brief position hold during the decel, then power-off leaves
            // the motor free. (MOVING already disables via STOPPING; this makes
            // READY consistent. A normal idle disable just no-op-stops through it.)
            eState := E_MotorState.STOPPING;
        ELSIF fbPower.Error THEN
            eState := E_MotorState.ERROR;
        ELSIF rtStop.Q THEN
            eState := E_MotorState.STOPPING;
        ELSIF rtHome.Q THEN
            eState := E_MotorState.HOMING;
        ELSIF rtExecuteMove.Q THEN
            bMoveLatch := TRUE;
            eState     := E_MotorState.MOVING;
        END_IF

    E_MotorState.MOVING:
        IF NOT stCmd.bEnable OR rtStop.Q THEN
            bMoveLatch := FALSE;
            eState     := E_MotorState.STOPPING;

        ELSIF stCmd.eControlMode = E_ControlMode.POSITION THEN
            IF stCmd.bRelative THEN
                IF fbMoveRel.Busy  THEN bMoveLatch := FALSE; END_IF
                IF fbMoveRel.Done  THEN eState := E_MotorState.READY; END_IF
                IF fbMoveRel.Error THEN eState := E_MotorState.ERROR; END_IF
            ELSE
                IF fbMoveAbs.Busy  THEN bMoveLatch := FALSE; END_IF
                IF fbMoveAbs.Done  THEN eState := E_MotorState.READY; END_IF
                IF fbMoveAbs.Error THEN eState := E_MotorState.ERROR; END_IF
            END_IF

        ELSIF stCmd.eControlMode = E_ControlMode.VELOCITY THEN
            IF stCmd.fTargetVelocity <> fPrevVelocity THEN
                fPrevVelocity := stCmd.fTargetVelocity;
                bMoveLatch    := TRUE;
            END_IF
            IF fbMoveVel.Busy  THEN bMoveLatch := FALSE; END_IF
            IF fbMoveVel.Error THEN eState := E_MotorState.ERROR; END_IF

        ELSE
            eState := E_MotorState.READY;
        END_IF

    E_MotorState.STOPPING:
        IF fbStop.Error THEN
            eState := E_MotorState.ERROR;
        ELSIF fbStop.Done THEN
            eState := SEL(stCmd.bEnable, E_MotorState.DISABLED, E_MotorState.READY);
        END_IF

    E_MotorState.HOMING:
        fbHome(Axis := Axis, Execute := TRUE, HomingMode := MC_DefaultHoming);
        IF fbHome.Error THEN
            eState := E_MotorState.ERROR;
        ELSIF fbHome.Done THEN
            stStatus.bHomingDone := TRUE;
            eState               := E_MotorState.READY;
        END_IF

    E_MotorState.ERROR:
        IF rtResetError.Q THEN
            // Sequenced recovery: clear the DRIVE fault first (SoE S-0-0099),
            // give the drive a settle gap, THEN reset the NC axis against the
            // healthy drive. Sequenced on COMPLETION (Busy/Done), not timers.
            bSoeResetExec := TRUE;
            nResetStage   := 1;
            eState        := E_MotorState.RESETTING;
        END_IF

    E_MotorState.RESETTING:
        // Whole-sequence watchdog: if any stage hangs (e.g. a latch that never
        // clears), give up and go BACK TO ERROR — visible failure, another
        // reset press retries. Without this a stuck stage is unrecoverable
        // until a PLC restart.
        tonResetGuard(IN := TRUE, PT := T_RESET_GUARD);
        IF tonResetGuard.Q THEN
            tonResetGuard(IN := FALSE);
            bSoeResetExec := FALSE;
            bNcResetExec  := FALSE;
            nResetStage   := 0;
            eState        := E_MotorState.ERROR;
        END_IF
        CASE nResetStage OF
            1:  // SoE drive reset running — the latch self-clears when the
                // FB's Busy falls (done) or it errors/times out (10 s)
                IF NOT bSoeResetExec THEN
                    tonSettle(IN := FALSE);
                    nResetStage := 2;
                END_IF
            2:  // settle: let the drive's state machine come back up before
                // the NC touches it
                tonSettle(IN := TRUE, PT := T_RESET_SETTLE);
                IF tonSettle.Q THEN
                    tonSettle(IN := FALSE);
                    bNcResetExec := TRUE;
                    nResetStage  := 3;
                END_IF
            3:  // NC axis reset — latch self-clears on Done/Error
                IF NOT bNcResetExec THEN
                    tonResetGuard(IN := FALSE);
                    stStatus.bError   := FALSE;
                    stStatus.nErrorID := 0;
                    nResetStage       := 0;
                    eState            := E_MotorState.DISABLED;
                END_IF
        END_CASE

END_CASE

//----------------------------------------------------------------------
// STATUS OUTPUTS
//----------------------------------------------------------------------
stStatus.eState       := eState;
stStatus.eControlMode := stCmd.eControlMode;
stStatus.nResetStage  := nResetStage;
stStatus.bEnabled     := fbPower.Status;
stStatus.bMoving      := fbMoveAbs.Busy OR fbMoveRel.Busy OR fbMoveVel.Busy;
stStatus.bAtTarget    := fbMoveAbs.Done OR fbMoveRel.Done OR fbMoveVel.InVelocity;
stStatus.bError       := fbPower.Error   OR fbMoveAbs.Error OR fbMoveRel.Error
                      OR fbMoveVel.Error OR fbStop.Error    OR fbHome.Error;

IF stStatus.bError AND stStatus.nErrorID = 0 THEN
    stStatus.nErrorID := SEL(fbPower.Error,   0, fbPower.ErrorID)
                       + SEL(fbMoveAbs.Error, 0, fbMoveAbs.ErrorID)
                       + SEL(fbMoveRel.Error, 0, fbMoveRel.ErrorID)
                       + SEL(fbMoveVel.Error, 0, fbMoveVel.ErrorID)
                       + SEL(fbStop.Error,    0, fbStop.ErrorID)
                       + SEL(fbHome.Error,    0, fbHome.ErrorID);
END_IF

stStatus.fActPosition := Axis.NcToPlc.ActPos;
stStatus.fActVelocity := Axis.NcToPlc.ActVelo;
stStatus.fActTorque   := INT_TO_LREAL(nActTorque_Raw) / 10.0;
stStatus.nTimestamp   := ULINT_TO_UDINT(F_GetSystemTime() / 10000);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>