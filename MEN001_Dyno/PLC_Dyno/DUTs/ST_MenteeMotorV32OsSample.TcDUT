<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MenteeMotorV32OsSample" Id="{8d32101a-96bd-4154-848c-aeb8105ad132}">
    <Declaration><![CDATA[TYPE ST_MenteeMotorV32OsSample :
STRUCT
    // Generic oversample slot (flex-PDO 0x6001). w0/w1/w2 are RAW 32-bit words;
    // the master reinterprets them per GROUP_ID (status_word [14:12]):
    //   GROUP 0 STANDARD: w0=theta(F)  w1=d_theta(F)   w2=iq(F)
    //   GROUP 1 TORQUE   : per 3-slot capture — see MASTER_INTERFACE.md / the app
    //                      decoder (theta/d_theta/dd_theta, torque_raw_1..4, iq, measured_torque)
    sample_idx  : UDINT;    // sN_sample_idx — device oversample index
    w0          : UDINT;    // sN_w0 — raw word (float-bits or uint32 per group)
    w1          : UDINT;    // sN_w1
    w2          : UDINT;    // sN_w2
    // Extended lanes 3..9 — ELF-picked debug variables on the slot-2 debug
    // pipe. Filled by FB_Slot2PipeHandler's STANDARD view from the SAME
    // capture index k as w0..w2 (the FW samples every bound lane on one
    // shared prescaler tick), so one aSamples[k] is one synchronized instant
    // stamped by sample_idx. Stay 0 on the legacy fixed PDO / TORQUE view.
    w3          : UDINT;
    w4          : UDINT;
    w5          : UDINT;
    w6          : UDINT;
    w7          : UDINT;
    w8          : UDINT;
    w9          : UDINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>