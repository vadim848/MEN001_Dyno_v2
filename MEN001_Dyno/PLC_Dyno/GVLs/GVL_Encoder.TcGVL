<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_Encoder" Id="{03bfccee-2404-4de2-afd4-bf2dbe0ac154}">
    <Declaration><![CDATA[{attribute 'TcGvlVarFlags' := 'OPC'}
VAR_GLOBAL
    // EL5112 encoder data — written by FB_EncoderHandler, read by Python over ADS
    // ADS symbol: GVL_Encoder.stEncoder
    stEncoder1          : ST_EncoderData;
    stEncoder2          : ST_EncoderData;

    // Encoder scaling — set once from Python or MAIN
    // fCountsPerUnit: how many encoder counts = 1 engineering unit
    // Example: 4096 counts/rev with units in degrees → fCountsPerUnit = 4096/360
    fCountsPerUnit1     : LREAL := 1.0;
    fCountsPerUnit2     : LREAL := 1.0;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>