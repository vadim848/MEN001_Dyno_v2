<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_MenteeMotorV32OsHandler" Id="{8ad0502d-ebf1-44f5-9f80-c197636cc2b6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MenteeMotorV32OsHandler
VAR_IN_OUT
    stCmd       : ST_MenteeMotorV32OsCmd;      // From GVL_MenteeMotorV32_OS
    stStatus    : ST_MenteeMotorV32OsStatus;   // To GVL_MenteeMotorV32_OS
END_VAR

VAR
    //--- RxPDO 0x1601 outputs — AT %Q* — link to box 0x1601 entries in XAE ---
    q_control_word          AT %Q* : UDINT; // 0x7001:01 control_word
    q_impedance_p_des       AT %Q* : REAL;  // 0x7001:02 impedance_p_des
    q_impedance_v_des       AT %Q* : REAL;  // 0x7001:03 impedance_v_des
    q_impedance_kp          AT %Q* : REAL;  // 0x7001:04 impedance_kp
    q_impedance_kd          AT %Q* : REAL;  // 0x7001:05 impedance_kd
    q_impedance_torque_ff   AT %Q* : REAL;  // 0x7001:06 impedance_torque_ff
    q_setpoint_position     AT %Q* : REAL;  // 0x7001:07 setpoint_position
    q_setpoint_velocity     AT %Q* : REAL;  // 0x7001:08 setpoint_velocity
    q_setpoint_current      AT %Q* : REAL;  // 0x7001:09 setpoint_current

    //--- TxPDO 0x1A01 inputs — AT %I* — link to box 0x1A01 entries in XAE ---
    i_status_word           AT %I* : UDINT; // 0x6001:01 status_word
    i_sample_count          AT %I* : UDINT; // 0x6001:02 sample_count

    // Generic slots { sample_idx, w0, w1, w2 } — all UDINT raw words. Re-link to
    // box 0x1A01 entries sN_sample_idx / sN_w0 / sN_w1 / sN_w2 after importing the
    // flex-PDO ESI; the master reinterprets w0/w1/w2 per GROUP_ID.
    i_s0_sample_idx         AT %I* : UDINT; // 0x6001:03
    i_s0_w0                 AT %I* : UDINT; // 0x6001:04
    i_s0_w1                 AT %I* : UDINT; // 0x6001:05
    i_s0_w2                 AT %I* : UDINT; // 0x6001:06
    i_s1_sample_idx         AT %I* : UDINT; // 0x6001:07
    i_s1_w0                 AT %I* : UDINT; // 0x6001:08
    i_s1_w1                 AT %I* : UDINT; // 0x6001:09
    i_s1_w2                 AT %I* : UDINT; // 0x6001:0A
    i_s2_sample_idx         AT %I* : UDINT; // 0x6001:0B
    i_s2_w0                 AT %I* : UDINT; // 0x6001:0C
    i_s2_w1                 AT %I* : UDINT; // 0x6001:0D
    i_s2_w2                 AT %I* : UDINT; // 0x6001:0E
    i_s3_sample_idx         AT %I* : UDINT; // 0x6001:0F
    i_s3_w0                 AT %I* : UDINT; // 0x6001:10
    i_s3_w1                 AT %I* : UDINT; // 0x6001:11
    i_s3_w2                 AT %I* : UDINT; // 0x6001:12
    i_s4_sample_idx         AT %I* : UDINT; // 0x6001:13
    i_s4_w0                 AT %I* : UDINT; // 0x6001:14
    i_s4_w1                 AT %I* : UDINT; // 0x6001:15
    i_s4_w2                 AT %I* : UDINT; // 0x6001:16
    i_s5_sample_idx         AT %I* : UDINT; // 0x6001:17
    i_s5_w0                 AT %I* : UDINT; // 0x6001:18
    i_s5_w1                 AT %I* : UDINT; // 0x6001:19
    i_s5_w2                 AT %I* : UDINT; // 0x6001:1A
    i_s6_sample_idx         AT %I* : UDINT; // 0x6001:1B
    i_s6_w0                 AT %I* : UDINT; // 0x6001:1C
    i_s6_w1                 AT %I* : UDINT; // 0x6001:1D
    i_s6_w2                 AT %I* : UDINT; // 0x6001:1E
    i_s7_sample_idx         AT %I* : UDINT; // 0x6001:1F
    i_s7_w0                 AT %I* : UDINT; // 0x6001:20
    i_s7_w1                 AT %I* : UDINT; // 0x6001:21
    i_s7_w2                 AT %I* : UDINT; // 0x6001:22
    i_s8_sample_idx         AT %I* : UDINT; // 0x6001:23
    i_s8_w0                 AT %I* : UDINT; // 0x6001:24
    i_s8_w1                 AT %I* : UDINT; // 0x6001:25
    i_s8_w2                 AT %I* : UDINT; // 0x6001:26
    i_s9_sample_idx         AT %I* : UDINT; // 0x6001:27
    i_s9_w0                 AT %I* : UDINT; // 0x6001:28
    i_s9_w1                 AT %I* : UDINT; // 0x6001:29
    i_s9_w2                 AT %I* : UDINT; // 0x6001:2A

    uReinterpret            : U_WordReal;   // UDINT-bits -> REAL for fLatest* decode
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//----------------------------------------------------------------------
// WRITE RxPDO 0x1601 — GVL_MenteeMotorV32_OS.stCmd -> device every cycle
//----------------------------------------------------------------------
q_control_word        := stCmd.nControlWord;
q_impedance_p_des     := stCmd.impedance_p_des;
q_impedance_v_des     := stCmd.impedance_v_des;
q_impedance_kp        := stCmd.impedance_kp;
q_impedance_kd        := stCmd.impedance_kd;
q_impedance_torque_ff := stCmd.impedance_torque_ff;
q_setpoint_position   := stCmd.setpoint_position;
q_setpoint_velocity   := stCmd.setpoint_velocity;
q_setpoint_current    := stCmd.setpoint_current;

//----------------------------------------------------------------------
// READ TxPDO 0x1A01 — device -> GVL_MenteeMotorV32_OS.stStatus every cycle
//----------------------------------------------------------------------
stStatus.nStatusWord  := i_status_word;
stStatus.nSampleCount := i_sample_count;

stStatus.aSamples[0].sample_idx := i_s0_sample_idx;
stStatus.aSamples[0].w0         := i_s0_w0;
stStatus.aSamples[0].w1         := i_s0_w1;
stStatus.aSamples[0].w2         := i_s0_w2;
stStatus.aSamples[1].sample_idx := i_s1_sample_idx;
stStatus.aSamples[1].w0         := i_s1_w0;
stStatus.aSamples[1].w1         := i_s1_w1;
stStatus.aSamples[1].w2         := i_s1_w2;
stStatus.aSamples[2].sample_idx := i_s2_sample_idx;
stStatus.aSamples[2].w0         := i_s2_w0;
stStatus.aSamples[2].w1         := i_s2_w1;
stStatus.aSamples[2].w2         := i_s2_w2;
stStatus.aSamples[3].sample_idx := i_s3_sample_idx;
stStatus.aSamples[3].w0         := i_s3_w0;
stStatus.aSamples[3].w1         := i_s3_w1;
stStatus.aSamples[3].w2         := i_s3_w2;
stStatus.aSamples[4].sample_idx := i_s4_sample_idx;
stStatus.aSamples[4].w0         := i_s4_w0;
stStatus.aSamples[4].w1         := i_s4_w1;
stStatus.aSamples[4].w2         := i_s4_w2;
stStatus.aSamples[5].sample_idx := i_s5_sample_idx;
stStatus.aSamples[5].w0         := i_s5_w0;
stStatus.aSamples[5].w1         := i_s5_w1;
stStatus.aSamples[5].w2         := i_s5_w2;
stStatus.aSamples[6].sample_idx := i_s6_sample_idx;
stStatus.aSamples[6].w0         := i_s6_w0;
stStatus.aSamples[6].w1         := i_s6_w1;
stStatus.aSamples[6].w2         := i_s6_w2;
stStatus.aSamples[7].sample_idx := i_s7_sample_idx;
stStatus.aSamples[7].w0         := i_s7_w0;
stStatus.aSamples[7].w1         := i_s7_w1;
stStatus.aSamples[7].w2         := i_s7_w2;
stStatus.aSamples[8].sample_idx := i_s8_sample_idx;
stStatus.aSamples[8].w0         := i_s8_w0;
stStatus.aSamples[8].w1         := i_s8_w1;
stStatus.aSamples[8].w2         := i_s8_w2;
stStatus.aSamples[9].sample_idx := i_s9_sample_idx;
stStatus.aSamples[9].w0         := i_s9_w0;
stStatus.aSamples[9].w1         := i_s9_w1;
stStatus.aSamples[9].w2         := i_s9_w2;

//----------------------------------------------------------------------
// DECODE STATUS WORD (mirrors FB_UartBridgeHandler — VERIFY vs motor FW)
//----------------------------------------------------------------------
stStatus.nFsmState            := UDINT_TO_BYTE(i_status_word AND 16#0000000F);
stStatus.nMainState           := UDINT_TO_BYTE((i_status_word / 16#10)       AND 16#0F);
stStatus.nOpMode              := UDINT_TO_BYTE((i_status_word / 16#100)      AND 16#07);
stStatus.nGroupId             := UDINT_TO_BYTE((i_status_word / 16#1000)     AND 16#07);  // bits 14:12
stStatus.nGeneralErrorBits    := UDINT_TO_BYTE((i_status_word / 16#10000)    AND 16#FF);
stStatus.nCategorialErrorBits := UDINT_TO_BYTE((i_status_word / 16#1000000)  AND 16#FF);

// Newest slot, reinterpreted as REAL (GROUP 0 semantics: w0/w1/w2 = theta/d_theta/iq).
uReinterpret.u := i_s9_w0; stStatus.fLatestPos     := uReinterpret.f;
uReinterpret.u := i_s9_w1; stStatus.fLatestVel     := uReinterpret.f;
uReinterpret.u := i_s9_w2; stStatus.fLatestCurrent := uReinterpret.f;
stStatus.bError               := (stStatus.nGeneralErrorBits <> 0)
                               OR (stStatus.nCategorialErrorBits <> 0);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>