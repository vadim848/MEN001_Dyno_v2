<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_TrajectoryGen" Id="{c2f8d1b3-5e42-4a7b-8d3f-6b1c2e3a4d50}" SpecialFunc="None">
    <Declaration><![CDATA[// Generic 1 kHz motion-profile generator for the V3.2 motor. Evaluates the
// selected shape as value(t) online (no precomputed array) and streams it to
// the field PRG_Motion routes by nField. Shapes ported from the Cheetah
// ProfileGenerator: Sinusoidal / Trapezoidal / Step / S-Curve / Ramp.
//
// On Start the command is LATCHED into 'cfg' (a local copy of stTraj). The
// generator + the valueAt method read 'cfg' only -- so mid-run parameter
// changes are ignored, and the method never touches the VAR_IN_OUT (no C0371).
//
// Anchoring: for position-target fields (nField 0/1) the profile rides on the
// rotor's position captured at Start -> out = startPos + (value(t) - value(0)),
// so it begins exactly where the motor is (no jump). Velocity/current (2/3) use
// the value directly. Repetitive loops the whole profile (nReps; 0 = infinite),
// resting fRestS between reps.
FUNCTION_BLOCK FB_TrajectoryGen
VAR_IN_OUT
    stTraj          : ST_MenteeTrajCmd;
END_VAR
VAR_INPUT
    fMeasuredPos    : REAL;     // current measured output position [rad]
    fDt             : REAL;     // task cycle time [s]
    bStartSync      : BOOL;     // shared synchronized start (PRG_Motion gates with the Mentee enable)
    bStopSync       : BOOL;     // shared synchronized stop
END_VAR
VAR_OUTPUT
    bRunning        : BOOL;
    fSetpoint       : REAL;
END_VAR
VAR
    cfg             : ST_MenteeTrajCmd;   // latched command (read by body + valueAt)
    rStart          : R_TRIG;
    rStop           : R_TRIG;
    eState          : INT;      // see ST_* constants
    fElapsed        : REAL;     // time into the current run [s]
    fTotalDur       : REAL;     // total duration of one run [s]
    fStartPos       : REAL;     // anchor position (captured at Start)
    fValue0         : REAL;     // value(0) for anchoring
    bAnchor         : BOOL;     // position-target field -> anchor at current pos
    nRepDone        : UDINT;
    fRest           : REAL;     // rest countdown [s]
    fRaw            : REAL;
    bWasActive      : BOOL;
END_VAR
VAR CONSTANT
    ST_IDLE         : INT := 0;
    ST_RUN          : INT := 1;
    ST_REST         : INT := 2;
    ST_DONE         : INT := 3;
    SH_SINE         : BYTE := 0;
    SH_TRAP         : BYTE := 1;
    SH_STEP         : BYTE := 2;
    SH_SCURVE       : BYTE := 3;
    SH_RAMP         : BYTE := 4;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[rStart(CLK := stTraj.bStart OR bStartSync);
rStop(CLK := stTraj.bStop OR bStopSync);

// Stop -> hold current position (idle; PRG_Motion stops overriding the field).
IF rStop.Q THEN
    eState := ST_IDLE;
END_IF

// Start a new run -> latch the command into cfg; everything below reads cfg.
IF rStart.Q AND (stTraj.nShape <= SH_RAMP) AND (stTraj.nField <= 3) THEN
    cfg      := stTraj;
    fElapsed := 0.0;
    nRepDone := 0;
    // total duration of one run, per shape
    IF (cfg.nShape = SH_TRAP) OR (cfg.nShape = SH_SCURVE) THEN
        fTotalDur := cfg.fAccelTime + cfg.fSteadyTime + cfg.fDecelTime;
    ELSE
        fTotalDur := cfg.fDuration;
    END_IF
    // position-target fields ride on the current position (no jump)
    bAnchor := (cfg.nField = 0) OR (cfg.nField = 1);
    IF bAnchor THEN
        fStartPos := fMeasuredPos;
        fValue0   := valueAt(0.0);
    ELSE
        fStartPos := 0.0;
        fValue0   := 0.0;
    END_IF
    eState := ST_RUN;
END_IF

// "Active this cycle" is latched BEFORE transitions so the cycle that ends the
// run still writes the final value.
bWasActive := (eState = ST_RUN) OR (eState = ST_REST);

CASE eState OF

ST_RUN:
    fRaw := valueAt(fElapsed);
    IF bAnchor THEN
        stTraj.fSetpoint := fStartPos + (fRaw - fValue0);
    ELSE
        stTraj.fSetpoint := fRaw;
    END_IF
    fElapsed := fElapsed + fDt;
    IF fElapsed >= fTotalDur THEN
        // land on the exact end value
        fRaw := valueAt(fTotalDur);
        IF bAnchor THEN
            stTraj.fSetpoint := fStartPos + (fRaw - fValue0);
        ELSE
            stTraj.fSetpoint := fRaw;
        END_IF
        IF NOT cfg.bRepetitive THEN
            eState := ST_DONE;
        ELSE
            nRepDone := nRepDone + 1;
            IF (cfg.nReps > 0) AND (nRepDone >= cfg.nReps) THEN
                eState := ST_DONE;
            ELSE
                fRest  := cfg.fRestS;
                eState := ST_REST;
            END_IF
        END_IF
    END_IF

ST_REST:
    fRest := fRest - fDt;                   // hold last setpoint during the rest
    IF fRest <= 0.0 THEN
        fElapsed := 0.0;
        eState   := ST_RUN;
    END_IF

ST_DONE:
    ;                                       // hold fSetpoint

ST_IDLE:
    ;                                       // not running

END_CASE

stTraj.fElapsed := fElapsed;
bRunning        := bWasActive;
fSetpoint       := stTraj.fSetpoint;
stTraj.bRunning := bRunning;
]]></ST>
    </Implementation>
    <Method Name="valueAt" Id="{d3a9e2c4-6f53-4b8c-9e4a-7c2d3f4b5e61}">
      <Declaration><![CDATA[// Shape value at time fT [s] — closed-form, mirrors the Cheetah ProfileGenerator.
// Reads the latched 'cfg' (FB-local), never the VAR_IN_OUT.
METHOD valueAt : REAL
VAR_INPUT
    fT  : REAL;
END_VAR
VAR
    fU  : REAL;
END_VAR
VAR CONSTANT
    TWO_PI : REAL := 6.2831853;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE cfg.nShape OF

0:  // Sinusoidal: offset + A * sin(2*pi*f*t)
    valueAt := cfg.fOffset + cfg.fAmplitude * SIN(TWO_PI * cfg.fFrequency * fT);

1:  // Trapezoidal: ramp start->peak / hold / ramp peak->start
    IF fT < cfg.fAccelTime THEN
        valueAt := cfg.fStartValue
                 + (cfg.fPeakValue - cfg.fStartValue) * (fT / MAX(cfg.fAccelTime, 1E-6));
    ELSIF fT < (cfg.fAccelTime + cfg.fSteadyTime) THEN
        valueAt := cfg.fPeakValue;
    ELSE
        fU := (fT - cfg.fAccelTime - cfg.fSteadyTime) / MAX(cfg.fDecelTime, 1E-6);
        IF fU > 1.0 THEN fU := 1.0; END_IF
        valueAt := cfg.fPeakValue - (cfg.fPeakValue - cfg.fStartValue) * fU;
    END_IF

2:  // Step: start until step time, then end
    IF fT < cfg.fStepTime THEN
        valueAt := cfg.fStartValue;
    ELSE
        valueAt := cfg.fEndValue;
    END_IF

3:  // S-Curve: quintic smoothstep start->peak / hold / peak->start
    IF fT < cfg.fAccelTime THEN
        fU := fT / MAX(cfg.fAccelTime, 1E-6);
        valueAt := cfg.fStartValue
                 + (cfg.fPeakValue - cfg.fStartValue) * (fU*fU*fU*(10.0 + fU*(-15.0 + fU*6.0)));
    ELSIF fT < (cfg.fAccelTime + cfg.fSteadyTime) THEN
        valueAt := cfg.fPeakValue;
    ELSE
        fU := (fT - cfg.fAccelTime - cfg.fSteadyTime) / MAX(cfg.fDecelTime, 1E-6);
        IF fU > 1.0 THEN fU := 1.0; END_IF
        valueAt := cfg.fPeakValue
                 - (cfg.fPeakValue - cfg.fStartValue) * (fU*fU*fU*(10.0 + fU*(-15.0 + fU*6.0)));
    END_IF

4:  // Ramp: linear start->end over duration
    fU := fT / MAX(cfg.fDuration, 1E-6);
    IF fU > 1.0 THEN fU := 1.0; END_IF
    valueAt := cfg.fStartValue + (cfg.fEndValue - cfg.fStartValue) * fU;

ELSE
    valueAt := 0.0;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
