<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_UartBridge" Id="{2305e438-ee8c-41a7-b817-12d184bfd1e9}">
    <Declaration><![CDATA[{attribute 'TcGvlVarFlags' := 'OPC'}
VAR_GLOBAL
    // Commands — written by Python over ADS, sent to device every cycle
    // ADS symbol: GVL_UartBridge.stCmd
    stCmd               : ST_UartBridgeCmd;

    // Status — read from device every cycle, read by Python over ADS
    // ADS symbol: GVL_UartBridge.stStatus
    stStatus            : ST_UartBridgeStatus;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>