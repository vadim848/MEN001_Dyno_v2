<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="E_MotorState" Id="{4a769046-4981-4290-9f20-8fe275f2e7c8}">
    <Declaration><![CDATA[TYPE E_MotorState :
(
    DISABLED    := 0,
    ENABLING    := 1,
    READY       := 2,
    MOVING      := 3,
    STOPPING    := 4,
    HOMING      := 5,
    ERROR       := 6
) UDINT := DISABLED;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>