<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MenteeMotorV32OsCmd" Id="{a00674d0-aa71-4d21-baee-fa5259042d7c}">
    <Declaration><![CDATA[// RxPDO 0x1601 "Motor Command OS" — written by TwinCAT to Motor Slave V3.2 (0x7001)
// Written by Python via GVL_MenteeMotorV32_OS, consumed by FB_Slot2PipeHandler
TYPE ST_MenteeMotorV32OsCmd :
STRUCT
    nControlWord        : UDINT;    // 0x7001:01 control_word (raw 32-bit; packed per motor FW)
    impedance_p_des     : REAL;     // 0x7001:02 impedance_p_des
    impedance_v_des     : REAL;     // 0x7001:03 impedance_v_des
    impedance_kp        : REAL;     // 0x7001:04 impedance_kp
    impedance_kd        : REAL;     // 0x7001:05 impedance_kd
    impedance_torque_ff : REAL;     // 0x7001:06 impedance_torque_ff
    setpoint_position   : REAL;     // 0x7001:07 setpoint_position
    setpoint_velocity   : REAL;     // 0x7001:08 setpoint_velocity
    setpoint_current    : REAL;     // 0x7001:09 setpoint_current
    // Spare inject lanes 0/1/8/9 — RAW 32-bit values the app streams into the
    // matching q_inject slots (the FB copies them verbatim, NOT via the float
    // union). The app bit-encodes per the ELF-picked var's dtype (float bits vs
    // int). Slots 2..7 are the default command set (FW self-bound); these 4 are
    // free for ELF-picked inject targets.
    nRawInject0         : UDINT;    // -> q_inject[0]  (spare)
    nRawInject1         : UDINT;    // -> q_inject[1]  (spare)
    nRawInject8         : UDINT;    // -> q_inject[8]  (spare)
    nRawInject9         : UDINT;    // -> q_inject[9]  (spare)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>